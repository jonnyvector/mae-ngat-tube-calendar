<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs ./publish at 09:45 and 17:45 (Mac local time, Bangkok). If the Mac is asleep then,
     launchd runs it once on wake. Installed by ./schedule; logs to .cache/publish.log. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jonnyhicks.maengat</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/jonathanhicks/dev/mae-gnat-dam-flow-predictor/publish</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>45</integer></dict>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/jonathanhicks/dev/mae-gnat-dam-flow-predictor/.cache/publish.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jonathanhicks/dev/mae-gnat-dam-flow-predictor/.cache/publish.log</string>
</dict>
</plist>
